# NVIDIA API key for AI-powered assignment feedback
LEARNPATH_NVIDIA_API_KEY=

# NVIDIA model name (e.g. nvidia/llama-3.1-nemotron-70b-instruct)
LEARNPATH_NVIDIA_MODEL=

# NVIDIA API base URL (optional, defaults to https://integrate.api.nvidia.com/v1)
LEARNPATH_NVIDIA_BASE_URL=

# Groq API key for Question Bank AI provider (future use)
LEARNPATH_GROQ_API_KEY=

# Groq model name (future use)
LEARNPATH_GROQ_MODEL=

# JWT signing secret (minimum 32 characters)
LEARNPATH_JWT_SECRET=

# SQL Server connection string
LEARNPATH_DB_CONNECTION=
