# ── docker compose (root .env) ───────────────────────────────────
# Copy to .env and fill in real values. Names here are interpolated by
# docker-compose.yml; the LEARNPATH_* names below are also the exact names
# the backend validates at startup (backend/Program.cs).

# SQL Server SA password (required, min 8 chars with uppercase, lowercase, digits)
DB_SA_PASSWORD=YourStrong!Passw0rd

# JWT signing secret (required by LEARNPATH_JWT_SECRET, min 32 characters)
JWT_SECRET=REPLACE_WITH_32_CHAR_SECRET_KEY_HERE

# NVIDIA API key for AI feedback (required by LEARNPATH_NVIDIA_API_KEY)
LEARNPATH_NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY

# Frontend URL for CORS (Vite dev server locally; http://localhost for the
# containerized frontend served by nginx on port 80)
FRONTEND_URL=http://localhost:5173

# API base URL baked into the frontend build (nginx frontend uses port 80)
VITE_API_BASE_URL=http://localhost:5000/api/v1
